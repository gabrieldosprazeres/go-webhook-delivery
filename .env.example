# Valores exclusivamente locais. Nunca reutilize estas credenciais fora do ambiente descartavel.
WDE_PROFILE=local
WDE_LOG_LEVEL=info
WDE_VERSION=dev

WDE_POSTGRES_PORT=5432
WDE_POSTGRES_SUPERUSER_PASSWORD=postgres-local-only
WDE_MIGRATOR_PASSWORD=migrator-local-only
WDE_API_DATABASE_PASSWORD=api-local-only
WDE_WORKER_DATABASE_PASSWORD=worker-local-only
WDE_ADMIN_DATABASE_PASSWORD=admin-local-only

WDE_API_HTTP_ADDR=:8080
WDE_API_OPERATIONAL_ADDR=127.0.0.1:9090
WDE_WORKER_OPERATIONAL_ADDR=127.0.0.1:9091
WDE_CHAOSLAB_HTTP_ADDR=127.0.0.1:8081
WDE_SHUTDOWN_TIMEOUT=30s
WDE_DATABASE_TIMEOUT=5s
WDE_INGRESS_TLS_TERMINATED=false
WDE_ENABLE_PPROF=false
WDE_ALLOW_HTTP_DESTINATIONS=true
WDE_EDGE_MAX_IN_FLIGHT=256
WDE_EDGE_GLOBAL=60000
WDE_EDGE_ORIGIN=600
WDE_EDGE_PREFIX=300
WDE_EDGE_WINDOW=1m
WDE_EDGE_MAX_BUCKETS=4096
WDE_QUOTA_INGEST_GLOBAL=10000
WDE_QUOTA_INGEST_WORKSPACE=200
WDE_QUOTA_INGEST_API_KEY=200
WDE_QUOTA_INGEST_WINDOW=1s
WDE_QUOTA_ENDPOINT_WRITE_GLOBAL=6000
WDE_QUOTA_ENDPOINT_WRITE_WORKSPACE=60
WDE_QUOTA_ENDPOINT_WRITE_API_KEY=60
WDE_QUOTA_ENDPOINT_WRITE_WINDOW=1m
WDE_QUOTA_QUERY_GLOBAL=30000
WDE_QUOTA_QUERY_WORKSPACE=300
WDE_QUOTA_QUERY_API_KEY=300
WDE_QUOTA_QUERY_WINDOW=1m
WDE_QUOTA_REPLAY_GLOBAL=1000
WDE_QUOTA_REPLAY_WORKSPACE=10
WDE_QUOTA_REPLAY_API_KEY=10
WDE_QUOTA_REPLAY_RESOURCE=2
WDE_QUOTA_REPLAY_WINDOW=1m
WDE_WORKER_CONCURRENCY=8
WDE_WORKER_CLAIM_BATCH_SIZE=8
WDE_WORKER_WORKSPACE_BATCH_LIMIT=2
WDE_WORKER_ENDPOINT_BATCH_LIMIT=2
WDE_WORKER_POLL_INTERVAL=250ms
WDE_WORKER_CLAIM_TIMEOUT=200ms
WDE_WORKER_REQUEST_TIMEOUT=10s
WDE_WORKER_LEASE_TTL=30s
WDE_WORKER_RETRY_BASE=1s
WDE_WORKER_RETRY_CAP=15m

# Obrigatorios apenas em production. Cada pepper deve ser independente: v1:<32 bytes base64url sem padding>.
# Keyring: JSON format_version=1 com chaves de 32 bytes; veja o README.
WDE_AUTH_PEPPER_FILE=
WDE_IDEMPOTENCY_PEPPER_FILE=
WDE_FINGERPRINT_PEPPER_FILE=
WDE_RATE_LIMIT_PEPPER_FILE=
WDE_CURSOR_PEPPER_FILE=
WDE_PAYLOAD_KEYRING_FILE=
WDE_SIGNING_KEYRING_FILE=
